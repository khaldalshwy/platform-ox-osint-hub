# ==============================================================================
# إعدادات البيئة والأسرار لمنصة الرصد العلني (Platform OX — OSINT Hub)
# ==============================================================================
# انسخ هذا الملف إلى (.env) للتشغيل المحلي، أو أضف هذه المتغيرات في
# إعدادات Secrets داخل Hugging Face Spaces عند النشر السحابي.
# ==============================================================================

# 1. قاعدة البيانات السحابية المجانية Turso (SQLite Cloud — 9GB Free)
# في حال عدم ضبطهما، يعمل النظام تلقائياً على قاعدة SQLite المحلية (Fallback).
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_token_here

# 2. مفتاح البث الملاحي الحي المجاني AISStream.io (WebSocket)
# في حال عدم ضبطه، يعمل الرادار البحري تلقائياً بوضع المحاكاة (🟡 محاكاة).
AISSTREAM_API_KEY=your_free_key_here
